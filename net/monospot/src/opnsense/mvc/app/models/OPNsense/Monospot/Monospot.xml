<model>
    <mount>//OPNsense/Monospot</mount>
    <description>Monospot Hotspot (SMS OTP captive portal)</description>
    <items>
        <general>
            <enabled type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </enabled>
            <zoneid type="IntegerField">
                <MinimumValue>0</MinimumValue>
                <MaximumValue>19</MaximumValue>
                <Default>0</Default>
                <Required>N</Required>
                <ValidationMessage>Captive portal zone numarası 0-19 arasında olmalı.</ValidationMessage>
            </zoneid>
            <portal_port type="IntegerField">
                <MinimumValue>1</MinimumValue>
                <MaximumValue>65535</MaximumValue>
                <Default>8100</Default>
                <Required>N</Required>
                <ValidationMessage>Geçerli bir port numarası girin.</ValidationMessage>
            </portal_port>
        </general>
        <collect5651>
            <enabled type="BooleanField">
                <Default>1</Default>
                <Required>Y</Required>
            </enabled>
            <retention_days type="IntegerField">
                <MinimumValue>1</MinimumValue>
                <MaximumValue>3650</MaximumValue>
                <Default>365</Default>
                <Required>N</Required>
                <ValidationMessage>Saklama süresi 1-3650 gün arasında olmalı.</ValidationMessage>
            </retention_days>
        </collect5651>
    </items>
</model>
