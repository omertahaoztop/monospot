<model>
    <mount>//OPNsense/Monospot</mount>
    <description>Monospot Hotspot (SMS OTP captive portal)</description>
    <items>
        <general>
            <enabled type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </enabled>
            <zoneid type="IntegerField">
                <MinimumValue>0</MinimumValue>
                <MaximumValue>19</MaximumValue>
                <Default>0</Default>
                <Required>N</Required>
                <ValidationMessage>Captive portal zone numarası 0-19 arasında olmalı.</ValidationMessage>
            </zoneid>
            <portal_port type="IntegerField">
                <MinimumValue>1</MinimumValue>
                <MaximumValue>65535</MaximumValue>
                <Default>8100</Default>
                <Required>N</Required>
                <ValidationMessage>Geçerli bir port numarası girin.</ValidationMessage>
            </portal_port>
        </general>
        <collect5651>
            <enabled type="BooleanField">
                <Default>1</Default>
                <Required>Y</Required>
            </enabled>
            <retention_days type="IntegerField">
                <MinimumValue>1</MinimumValue>
                <MaximumValue>3650</MaximumValue>
                <Default>365</Default>
                <Required>N</Required>
                <ValidationMessage>Saklama süresi 1-3650 gün arasında olmalı.</ValidationMessage>
            </retention_days>
        </collect5651>
        <!--
          Captive portal zone alanlarının form karşılığı. Verinin aslı core
          modelde (OPNsense/CaptivePortal) durur; buradaki tanımlar yalnız
          form widget'ı (arayüz seçenekleri, doğrulama) içindir ve yazılmaz.
        -->
        <captiveportal>
            <enabled type="BooleanField">
                <Default>1</Default>
                <Required>N</Required>
            </enabled>
            <interfaces type="InterfaceField">
                <Multiple>Y</Multiple>
                <Required>N</Required>
            </interfaces>
            <idletimeout type="IntegerField">
                <Default>0</Default>
                <MinimumValue>0</MinimumValue>
                <MaximumValue>10080</MaximumValue>
                <Required>N</Required>
            </idletimeout>
            <hardtimeout type="IntegerField">
                <Default>0</Default>
                <MinimumValue>0</MinimumValue>
                <MaximumValue>10080</MaximumValue>
                <Required>N</Required>
            </hardtimeout>
            <concurrentlogins type="BooleanField">
                <Default>1</Default>
                <Required>N</Required>
            </concurrentlogins>
            <roaming type="BooleanField">
                <Default>1</Default>
                <Required>N</Required>
            </roaming>
            <description type="TextField"/>
        </captiveportal>
    </items>
</model>
