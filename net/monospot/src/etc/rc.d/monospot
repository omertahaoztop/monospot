# PROVIDE: monospot
# REQUIRE: LOGIN
# KEYWORD: shutdown

. /etc/rc.subr

name="monospot"
rcvar=${name}_enable

start_precmd="${name}_prestart"
start_cmd="${name}_start"
stop_cmd="${name}_stop"
status_cmd="${name}_status"

load_rc_config "$name"
: ${monospot_enable="NO"}

lighttpd="/usr/local/sbin/lighttpd"
conffile="/var/etc/lighttpd-monospot.conf"
pidfile="/var/run/monospot-lighttpd.pid"
setup="/usr/local/opnsense/scripts/monospot/setup.sh"

monospot_prestart()
{
    # eksik çalışma zamanı dosyalarını hazırla (izinler, örnek ayarlar)
    ${setup} deploy
}

monospot_start()
{
    if [ ! -f "${conffile}" ]; then
        echo "yapılandırma dosyası yok: ${conffile} (önce 'configctl template reload OPNsense/Monospot')"
        exit 1
    fi
    if [ -f "${pidfile}" ] && pgrep -qF "${pidfile}" 2> /dev/null; then
        echo "zaten çalışıyor"
        exit 0
    fi
    echo "Monospot portal lighttpd başlatılıyor"
    ${lighttpd} -f "${conffile}"
}

monospot_stop()
{
    if [ -f "${pidfile}" ]; then
        echo "Monospot portal lighttpd durduruluyor"
        /bin/pkill -TERM -F "${pidfile}"
        rm -f "${pidfile}"
    else
        echo "çalışmıyor"
    fi
}

monospot_status()
{
    if [ -f "${pidfile}" ] && pgrep -qF "${pidfile}" 2> /dev/null; then
        echo "monospot çalışıyor (pid $(cat "${pidfile}"))"
        exit 0
    fi
    echo "monospot çalışmıyor"
    exit 1
}

run_rc_command "$1"
